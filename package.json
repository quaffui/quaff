{
  "name": "@quaffui/quaff",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quaffui/quaff.git"
  },
  "scripts": {
    "dev": "tsc -p plugins/tsconfig.json && vite dev",
    "open": "tsc -p plugins/tsconfig.json && vite dev --open",
    "build": "tsc -p plugins/tsconfig.json && svelte-kit sync && svelte-package && bun scripts/generateAutoImports.ts && bun run build:css && publint",
    "build:css": "vite build --config vite.config.scss.ts",
    "build:docs": "tsc -p plugins/tsconfig.json && bun scripts/docgenProps.ts && bun scripts/docgenSnippets.ts && svelte-kit sync && svelte-package && bun scripts/generateAutoImports.ts && vite build --config vite.config.scss.ts && QUAFF_DOCS_ASSETS=true vite build",
    "preview": "vite preview",
    "package": "tsc -p plugins/tsconfig.json && svelte-kit sync && svelte-package && bun scripts/generateAutoImports.ts && bun run build:css && publint",
    "check": "tsc -p plugins/tsconfig.json && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "tsc -p plugins/tsconfig.json && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:ssr": "vitest --project ssr",
    "test:build": "vitest --project build",
    "test:browser": "vitest --project browser",
    "lint": "prettier --plugin prettier-plugin-svelte . --check . && eslint .",
    "format": "prettier --plugin prettier-plugin-svelte . --write . && eslint . --fix",
    "docgen-props": "bun scripts/docgenProps.ts",
    "docgen-clean": "bun scripts/docgenClean.ts",
    "colorgen": "bun scripts/colorgen.ts",
    "docgen-snippets": "bun scripts/docgenSnippets.ts",
    "gen:plugins": "tsc -p plugins/tsconfig.json"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#utils": "./src/lib/utils/index.js",
    "#utils/*": "./src/lib/utils/*",
    "#docs": "./src/docs/index.js",
    "#docs/*": "./src/docs/*",
    "#internal/*": "./src/lib/internal/*",
    "#components": "./src/lib/components/index.js",
    "#components/*": "./src/lib/components/*",
    "#helpers": "./src/lib/helpers/index.js",
    "#helpers/*": "./src/lib/helpers/*",
    "#composables": "./src/lib/composables/index.js",
    "#composables/*": "./src/lib/composables/*",
    "#classes/*": "./src/lib/classes/*",
    "#css/*": "./src/lib/css/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./auto-imports": {
      "types": "./dist/autoImports.d.ts",
      "default": "./dist/autoImports.js"
    },
    "./auto-imports/globals": {
      "types": "./dist/auto-imports-globals.d.ts"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "svelte": "./dist/components/*"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "svelte": "./dist/meta.js"
    },
    "./css/*": "./dist/css/*",
    "./css/components/input.css": "./dist/css/shared/field.css",
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "default": "./dist/locales/*.js"
    },
    "./plugins/assets": {
      "types": "./dist/plugins/assets.d.ts",
      "default": "./dist/plugins/assets.js"
    },
    "./plugins/css": {
      "types": "./dist/plugins/css.d.ts",
      "default": "./dist/plugins/css.js"
    },
    "./components/navbar/QNavItem.svelte": {
      "types": "./dist/components/nav-item/QNavItem.svelte.d.ts",
      "svelte": "./dist/components/nav-item/QNavItem.svelte"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "@sveltejs/kit": "^2.62.0 || ^3.0.0",
    "shiki": "^4.2.0",
    "svelte": "^5.56.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/prettier": "^3.0.0",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "bun-types": "^1.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "estree-walker": "^3.0.3",
    "globals": "^17.13.0",
    "magic-string": "^1.4.3",
    "material-symbols": "^0.47.6",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.25",
    "sass": "^1.105.1",
    "shiki": "^4.5.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "dependencies": {
    "@quaffui/material-color-utilities": "^0.4.2",
    "@rollup/pluginutils": "^5.4.0",
    "esm-env": "^1.2.2",
    "harfbuzzjs": "^1.6.3",
    "postcss": "^8.5.29",
    "purgecss": "^8.0.0",
    "wawoff2": "^2.0.1"
  },
  "license": "MIT"
}
